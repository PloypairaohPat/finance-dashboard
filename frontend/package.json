{
  "name": "plaid-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@clerk/clerk-react": "^5.61.4",
    "@sentry/react": "^10.73.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-plaid-link": "^3.5.2",
    "react-router-dom": "^7.18.3",
    "react-scripts": "5.0.1",
    "recharts": "^3.8.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "typecheck": "tsc --noEmit",
    "repro:url-params": "node scripts/url-params-repro/run.mjs",
    "repro:link-nav": "node scripts/url-params-repro/link-nav-check.mjs"
  },
  "eslintConfig": {
    "rules": {
      "no-restricted-imports": [
        "error",
        {
          "paths": [
            {
              "name": "react-router-dom",
              "importNames": [
                "useSearchParams"
              ],
              "message": "Use useUrlParams from src/lib/useUrlParams.ts. useSearchParams' setter builds writes from the last render's params and can silently drop another writer's param; see scripts/url-params-repro/README.md."
            },
            {
              "name": "react-router",
              "importNames": [
                "useSearchParams"
              ],
              "message": "Use useUrlParams from src/lib/useUrlParams.ts. useSearchParams' setter builds writes from the last render's params and can silently drop another writer's param; see scripts/url-params-repro/README.md."
            }
          ]
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "src/lib/useUrlParams.ts"
        ],
        "rules": {
          "no-restricted-imports": "off"
        }
      }
    ]
  },
  "proxy": "http://localhost:3001",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^24.1.3",
    "typescript": "^5.9.3"
  }
}
