# M6.1 cross-tenant isolation test suite — LOCAL, EPHEMERAL Postgres only.
# Copy this file to .env.test (gitignored) and adjust if needed.
#
# Start the disposable test container (17-alpine matches production's Postgres
# 17.6, and the dev containers in docker-compose.dev.yml):
#   docker run -d --name findash-test-pg -e POSTGRES_USER=testuser \
#     -e POSTGRES_PASSWORD=testpass -e POSTGRES_DB=findash_test \
#     -p 127.0.0.1:55432:5432 postgres:17-alpine
#
# Then provision the schema against it (from backend/):
#   npm run test:db:setup
#
# Never point this at Supabase or any shared/remote database — tests/setup.ts
# refuses to run if this DATABASE_URL matches backend/.env's, or if the host/db
# name doesn't contain "test".
DATABASE_URL="postgresql://testuser:testpass@localhost:55432/findash_test?schema=public"
DIRECT_URL="postgresql://testuser:testpass@localhost:55432/findash_test?schema=public"

# Shadow DB — only `prisma migrate dev` needs one, and the test suite provisions
# its schema with `migrate deploy`, so this is optional here. It is listed for
# the rare case of running migrate dev against the test database. The container
# comes from docker-compose.dev.yml (npm run db:dev:up).
SHADOW_DATABASE_URL=postgresql://shadowuser:shadowpass@localhost:55435/findash_shadow

# Everything below has a safe dummy default supplied by tests/setup.ts if omitted.
# Listed here for reference / in case a test needs a real-looking value.
PLAID_CLIENT_ID=test-plaid-client-id
PLAID_SECRET=test-plaid-secret
PLAID_ENV=sandbox
# Must be exactly 32 bytes (64 hex chars) — utils/encrypt.ts uses aes-256-gcm.
ENCRYPTION_KEY=abababababababababababababababababababababababababababababababab
CLERK_SECRET_KEY=sk_test_dummy_isolation_suite
CLERK_PUBLISHABLE_KEY=pk_test_dummy_isolation_suite
