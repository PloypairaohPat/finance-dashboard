generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── User ──────────────────────────────────────────────────────────
model User {
  id           String        @id @default(cuid())
  email        String?       @unique
  createdAt    DateTime      @default(now())
  plaidItems   PlaidItem[]
  accounts     Account[]
  transactions Transaction[]
}

// ── PlaidItem ─────────────────────────────────────────────────────
model PlaidItem {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  itemId          String    @unique
  accessToken     String
  institutionId   String?
  institutionName String?
  cursor          String?
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  accounts        Account[]

  @@index([userId])
  @@index([userId, institutionId])
}

// ── Account ───────────────────────────────────────────────────────
model Account {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  plaidItemId      String
  plaidItem        PlaidItem     @relation(fields: [plaidItemId], references: [id])
  plaidAccountId   String        @unique
  name             String
  officialName     String?
  type             String
  subtype          String?
  mask             String?
  currentBalance   Decimal?      @db.Decimal(12, 2)
  availableBalance Decimal?      @db.Decimal(12, 2)
  isoCurrencyCode  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  transactions     Transaction[]

  @@index([userId])
  @@index([plaidItemId])
}

// ── Transaction ───────────────────────────────────────────────────
model Transaction {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  accountId          String
  account            Account   @relation(fields: [accountId], references: [id])
  plaidTransactionId String    @unique
  date               DateTime
  amount             Decimal   @db.Decimal(12, 2)
  name               String
  cleanName          String?
  merchantName       String?
  categoryPrimary    String?
  categoryDetailed   String?
  isoCurrencyCode    String?
  pending            Boolean   @default(false)
  rawJson            Json?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tags      String[]  @default([])
  notes     String?

  @@index([userId, date])
  @@index([userId, categoryPrimary])
  @@index([accountId])
}

// ── Budget ────────────────────────────────────────────────────────
model Budget {
  id           String   @id @default(cuid())
  userId       String
  category     String
  monthlyLimit Decimal  @db.Decimal(12, 2)
  month        String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, category, month])
  @@index([userId, month])
}

model BalanceSnapshot {
  id               String   @id @default(cuid())
  userId           String
  accountId        String
  accountName      String
  accountType      String
  currentBalance   Decimal  @db.Decimal(12, 2)
  availableBalance Decimal? @db.Decimal(12, 2)
  isoCurrencyCode  String?  @default("USD")
  date             DateTime @db.Date
  createdAt        DateTime @default(now())

  @@unique([accountId, date])
  @@index([userId, date])
  @@index([date])
}

model Alert {
  id           String    @id @default(uuid())
  userId       String
  kind         String
  fingerprint  String
  severity     String
  title        String
  body         String
  data         Json?
  triggeredAt  DateTime  @default(now())
  dismissedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@unique([userId, fingerprint])
  @@index([userId, triggeredAt(sort: Desc)])
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  type          String
  name          String
  targetAmount  Decimal?  @db.Decimal(12, 2)
  startAmount   Decimal?  @db.Decimal(12, 2)
  deadline      DateTime? @db.Date
  accountId     String?
  data          Json      @default("{}")
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([userId, createdAt(sort: Desc)])
}