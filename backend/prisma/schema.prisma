generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── User ──────────────────────────────────────────────────────────
// Single user for now. user_id is on every table from day one
// so there is zero refactoring needed when you add auth later.
model User {
  id           String        @id @default(cuid())
  email        String?       @unique
  createdAt    DateTime      @default(now())
  plaidItems   PlaidItem[]
  accounts     Account[]
  transactions Transaction[]
}

// ── PlaidItem ─────────────────────────────────────────────────────
// One row per connected bank item. Stores the encrypted access_token
// and the sync cursor used for delta fetches (/transactions/sync).
model PlaidItem {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  itemId          String    @unique
  accessToken     String                     // AES-256-GCM encrypted — never store plaintext
  institutionId   String?
  institutionName String?
  cursor          String?                    // /transactions/sync cursor — stored per item
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  accounts        Account[]

  @@index([userId])
  @@index([userId, institutionId])
}

// ── Account ───────────────────────────────────────────────────────
// One row per bank account (checking, savings, credit card, etc.)
model Account {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  plaidItemId      String
  plaidItem        PlaidItem     @relation(fields: [plaidItemId], references: [id])
  plaidAccountId   String        @unique
  name             String
  officialName     String?
  type             String
  subtype          String?
  mask             String?                   // last 4 digits
  currentBalance   Decimal?      @db.Decimal(12, 2)  // Decimal — never Float for money
  availableBalance Decimal?      @db.Decimal(12, 2)
  isoCurrencyCode  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  transactions     Transaction[]

  @@index([userId])
  @@index([plaidItemId])
}

// ── Transaction ───────────────────────────────────────────────────
// rawJson is immutable — stores the exact Plaid API response.
// Never update rawJson after insert. All derived fields come from it.
model Transaction {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  accountId          String
  account            Account   @relation(fields: [accountId], references: [id])
  plaidTransactionId String    @unique
  date               DateTime                // always stored in UTC
  amount             Decimal   @db.Decimal(12, 2)  // positive = debit, negative = credit
  name               String                  // raw merchant string from Plaid
  merchantName       String?                 // cleaned merchant name (Phase 2)
  categoryPrimary    String?                 // e.g. "Food and Drink"
  categoryDetailed   String?                 // e.g. "Food and Drink > Restaurants"
  isoCurrencyCode    String?
  pending            Boolean   @default(false)
  rawJson            Json?                   // immutable Plaid response — never UPDATE this
  deletedAt          DateTime?               // soft delete — never hard-delete transactions
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, date])
  @@index([userId, categoryPrimary])
  @@index([accountId])
}