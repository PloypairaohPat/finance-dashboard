generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ── User ──────────────────────────────────────────────────────────
model User {
  id           String        @id @default(cuid())
  email        String?       @unique
  createdAt    DateTime      @default(now())
  // M7.2 — day of the month (1–28) each money period starts on. 1 = calendar
  // months. Validated at the API (PUT /user/settings); see src/lib/period.ts.
  periodStartDay Int         @default(1)
  // Whether money in through a payment app (Venmo, Zelle, Cash App) counts as
  // income instead of netting against payments to people (R4). Off by default:
  // turning it on re-derives every past period. See docs/m7.3-classifier.md.
  paymentAppInflowsAreIncome Boolean @default(false)
  plaidItems   PlaidItem[]
  accounts     Account[]
  transactions Transaction[]
  subscriptionMarks SubscriptionMark[]
  budgets          Budget[]
  balanceSnapshots BalanceSnapshot[]
  alerts           Alert[]
  goals            Goal[]
}

// ── PlaidItem ─────────────────────────────────────────────────────
model PlaidItem {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  itemId          String    @unique
  accessToken     String
  institutionId   String?
  institutionName String?
  cursor          String?
  lastSyncedAt    DateTime?
  status          String    @default("healthy") // healthy | login_required | pending_expiration | revoked | error
  errorCode       String?
  lastErrorAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  accounts        Account[]

  @@index([userId])
  @@index([userId, institutionId])
}

// ── Account ───────────────────────────────────────────────────────
model Account {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  plaidItemId      String
  plaidItem        PlaidItem     @relation(fields: [plaidItemId], references: [id])
  plaidAccountId   String        @unique
  name             String
  officialName     String?
  type             String
  subtype          String?
  mask             String?
  currentBalance   Decimal?      @db.Decimal(12, 2)
  availableBalance Decimal?      @db.Decimal(12, 2)
  isoCurrencyCode  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  transactions     Transaction[]

  @@index([userId])
  @@index([plaidItemId])
}

// ── Transaction ───────────────────────────────────────────────────
model Transaction {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  accountId          String
  account            Account   @relation(fields: [accountId], references: [id])
  plaidTransactionId String    @unique
  date               DateTime
  amount             Decimal   @db.Decimal(12, 2)
  name               String
  cleanName          String?
  merchantName       String?
  categoryPrimary    String?
  categoryDetailed   String?
  isoCurrencyCode    String?
  pending            Boolean   @default(false)
  rawJson            Json?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tags      String[]  @default([])
  notes     String?

  // M7.3 — the user's own answer about what this row IS, when the rules get it
  // wrong. Scoped to payment-app money in: "income" or "repayment", null for
  // "whatever the rules say". Plaid sync never writes this column, so an
  // override survives a later sync of the same transaction.
  verdictOverride   String?
  verdictOverrideAt DateTime?

  // Plaid's entity ids, copied out of the payload so merchant identity can be
  // computed without reading rawJson (which is written on create only). Raw
  // ids, not a derived key: the identity rule lives in code and can change
  // without a backfill. Plaid sync writes both on create and on every update.
  //   merchantEntityId     — Plaid's merchant_entity_id
  //   counterpartyEntities — "<type>:<entity_id>" per counterparty that has an
  //                          entity id, in Plaid's order
  // No default, on purpose: NULL means "no new code has written this row yet",
  // which is how scripts/backfill-entity-columns.ts tells rows it may fill from
  // create-time rawJson from rows sync has written since. Every writer sets a
  // list, possibly empty.
  merchantEntityId     String?
  counterpartyEntities String[]

  subscriptionMarks SubscriptionMark[]

  @@index([userId, date])
  @@index([userId, categoryPrimary])
  @@index([accountId])
  // What SubscriptionMark's foreign key references, so a mark can only ever
  // point at a transaction of its own user.
  @@unique([id, userId])
}

// ── Budget ────────────────────────────────────────────────────────
model Budget {
  id           String   @id @default(cuid())
  userId       String
  // Every row belongs to a User row: the database refuses an orphan, so
  // nothing can outlive the user it belongs to ("delete my data").
  user         User     @relation(fields: [userId], references: [id])
  category     String
  monthlyLimit Decimal  @db.Decimal(12, 2)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, category])
  @@index([userId])
}

model BalanceSnapshot {
  id               String   @id @default(cuid())
  userId           String
  // Every row belongs to a User row: the database refuses an orphan, so
  // nothing can outlive the user it belongs to ("delete my data").
  user         User     @relation(fields: [userId], references: [id])
  accountId        String
  accountName      String
  accountType      String
  currentBalance   Decimal  @db.Decimal(12, 2)
  availableBalance Decimal? @db.Decimal(12, 2)
  isoCurrencyCode  String?  @default("USD")
  date             DateTime @db.Date
  createdAt        DateTime @default(now())

  @@unique([accountId, date])
  @@index([userId, date])
  @@index([date])
}

model Alert {
  id           String    @id @default(uuid())
  userId       String
  // Every row belongs to a User row: the database refuses an orphan, so
  // nothing can outlive the user it belongs to ("delete my data").
  user         User     @relation(fields: [userId], references: [id])
  kind         String
  fingerprint  String
  severity     String
  title        String
  body         String
  data         Json?
  triggeredAt  DateTime  @default(now())
  dismissedAt  DateTime?
  // M7.3: set when the condition that raised the alert stops being true, so an
  // alert can stop being active without the user dismissing it. An alert that is
  // resolved and later becomes true again is re-triggered, and its dismissal is
  // cleared — see runDetectors.
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@unique([userId, fingerprint])
  @@index([userId, triggeredAt(sort: Desc)])
  @@index([userId, resolvedAt])
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  // Every row belongs to a User row: the database refuses an orphan, so
  // nothing can outlive the user it belongs to ("delete my data").
  user         User     @relation(fields: [userId], references: [id])
  type          String
  name          String
  targetAmount  Decimal?  @db.Decimal(12, 2)
  startAmount   Decimal?  @db.Decimal(12, 2)
  deadline      DateTime? @db.Date
  accountId     String?
  data          Json      @default("{}")
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([userId, createdAt(sort: Desc)])
}

// "Mark as subscription": the user says the charge they marked is one. The
// mark stores only that charge (its anchor). Which merchant it is comes from
// the anchor's raw entity ids under the CURRENT identity rule
// (src/lib/merchantIdentity.ts), and which charges belong to it is walked from
// the anchor on every read (src/lib/subscriptionSeries.ts) — so a change to
// either rule never leaves a mark pointing at a stale key.
//
// The foreign key is (transactionId, userId) -> Transaction(id, userId): the
// database refuses a mark whose user is not its transaction's user. Deleting a
// transaction (unlinking or re-linking a bank) deletes its marks.
model SubscriptionMark {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  transactionId String
  transaction   Transaction @relation(fields: [transactionId, userId], references: [id, userId], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userId, transactionId])
  @@index([userId])
}
