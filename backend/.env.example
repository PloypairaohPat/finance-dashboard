# Copy this file to .env and fill in real values.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PORT=3001

# Database connection for whatever environment this .env represents. If you are
# pointing it at a deployed database (Supabase et al), that is fine — but note
# that NO migrate/reset command is allowed to use this file.
#
# Local schema work belongs in backend/.env.dev instead:
#   cp .env.dev.example .env.dev && npm run db:dev:up && npm run db:dev:migrate
#
# The db:dev:* scripts load .env.dev, and scripts/guard-local-db.ts hard-fails
# on any non-localhost URL, so `prisma migrate dev` can no longer reach prod.
DATABASE_URL=postgresql://user:password@host:5432/dbname
DIRECT_URL=postgresql://user:password@host:5432/dbname

# Must be exactly 32 bytes (64 hex chars) — utils/encrypt.ts uses aes-256-gcm.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-key
DEFAULT_USER_ID=
WEBHOOK_URL=
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
LOGO_DEV_TOKEN=
