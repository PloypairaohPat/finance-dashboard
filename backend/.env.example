# Copy this file to .env and fill in real values.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PORT=3001

# NEVER put a real database URL in this file — least of all production's.
#
# This file used to hold the production connection, and everything that loaded it
# reached production by default: `prisma migrate dev`, the demo seed, and
# `npm run dev` (which also starts the Plaid sync scheduler). Each was guarded
# separately; the cause was this file. Production credentials now live only in
# Railway's environment, which injects them at runtime — the deployed app does not
# read a .env file at all.
#
# These placeholders point at a `.invalid` host, which by definition can never
# resolve, so anything that falls back to this file fails loudly instead of
# connecting somewhere real. Local work uses backend/.env.dev:
#   cp .env.dev.example .env.dev && npm run db:dev:up && npm run db:dev:migrate
DATABASE_URL=postgresql://no-credentials:here@production-db-credentials-live-only-in-railway.invalid:5432/placeholder
DIRECT_URL=postgresql://no-credentials:here@production-db-credentials-live-only-in-railway.invalid:5432/placeholder

# Must be exactly 32 bytes (64 hex chars) — utils/encrypt.ts uses aes-256-gcm.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-key
DEFAULT_USER_ID=
WEBHOOK_URL=
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
LOGO_DEV_TOKEN=
