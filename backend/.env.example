# Your Plaid Client ID (found in Plaid Dashboard → Team Settings → Keys)
PLAID_CLIENT_ID=your_client_id_here

# Plaid Secret for the environment you're targeting
# Use the "Sandbox" secret for sandbox testing
PLAID_SECRET=your_sandbox_secret_here

# Plaid environment: sandbox | development | production
PLAID_ENV=sandbox

# Which products to enable (comma-separated)
# Options: transactions, auth, identity, assets, investments, liabilities
PLAID_PRODUCTS=transactions,auth

# Which country codes to support (comma-separated)
PLAID_COUNTRY_CODES=US

# Port for the Express server
PORT=3001
