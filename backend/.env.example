# Copy this file to .env and fill in real values.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PORT=3001

# Local Postgres for day-to-day dev (docker run --name findash-dev -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:17-alpine)
DATABASE_URL=postgresql://postgres:dev@localhost:5432/findash_dev
DIRECT_URL=postgresql://postgres:dev@localhost:5432/findash_dev

# Shadow DB used by `prisma migrate dev` to detect drift — a second local
# container, never the same database as DATABASE_URL above, and never Supabase.
#   docker run -d --name findash-shadow -e POSTGRES_PASSWORD=shadow -p 55435:5432 postgres:17-alpine
SHADOW_DATABASE_URL=postgresql://postgres:shadow@localhost:55435/postgres

# Must be exactly 32 bytes (64 hex chars) — utils/encrypt.ts uses aes-256-gcm.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-key
DEFAULT_USER_ID=
WEBHOOK_URL=
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
LOGO_DEV_TOKEN=
