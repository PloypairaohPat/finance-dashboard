# Local development database config — copy to backend/.env.dev (gitignored).
#
#   cp .env.dev.example .env.dev
#
# Every db:dev:* npm script loads THIS file (via dotenv-cli), never backend/.env.
# backend/.env holds the Supabase production connection; keeping the two in
# separate files is what stops `prisma migrate dev` from ever reaching prod.
#
# Bring the containers up first:
#   npm run db:dev:up      # docker compose -f ../docker-compose.dev.yml up -d
#
# scripts/guard-local-db.ts runs before every migrate/reset/seed and hard-fails
# if any URL below is not localhost. Do not point these at a remote host — the
# guard will refuse, and it is correct to.

# findash-dev-pg (docker-compose.dev.yml). No pgbouncer locally, so DATABASE_URL
# and DIRECT_URL are the same connection.
DATABASE_URL="postgresql://devuser:devpass@localhost:55433/findash_dev?schema=public"
DIRECT_URL="postgresql://devuser:devpass@localhost:55433/findash_dev?schema=public"

# findash-shadow-pg. Dropped and recreated by `prisma migrate dev` on every run
# — must be a different database from DATABASE_URL above.
SHADOW_DATABASE_URL="postgresql://shadowuser:shadowpass@localhost:55435/findash_shadow"

# ── App config ────────────────────────────────────────────────────────────
# Only needed if you run `npm run dev` against the local database rather than
# just applying migrations. Use sandbox/dev keys here, never production ones.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PORT=3001

# Must be exactly 32 bytes (64 hex chars) — utils/encrypt.ts uses aes-256-gcm.
# Generate with: openssl rand -hex 32
# This throwaway value is fine locally; it must NOT match the production key,
# or local rows would be readable with prod's key and vice versa.
ENCRYPTION_KEY=abababababababababababababababababababababababababababababababab

CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-dev-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-dev-secret-key
DEFAULT_USER_ID=
WEBHOOK_URL=
LOGO_DEV_TOKEN=
