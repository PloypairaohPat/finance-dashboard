{
  "name": "plaid-backend",
  "version": "1.0.0",
  "description": "Plaid integration backend",
  "main": "dist/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "npm run db:guard",
    "dev": "dotenv -e .env.dev -- nodemon --watch src --ext ts --exec tsx src/server.ts",
    "build": "npx prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "npm run db:dev:migrate",
    "db:dev:up": "docker compose -f ../docker-compose.dev.yml up -d",
    "db:dev:down": "docker compose -f ../docker-compose.dev.yml down",
    "db:guard": "dotenv -e .env.dev -- tsx scripts/guard-local-db.ts",
    "predb:dev:migrate": "npm run db:guard",
    "db:dev:migrate": "dotenv -e .env.dev -- prisma migrate dev",
    "predb:dev:reset": "npm run db:guard",
    "db:dev:reset": "dotenv -e .env.dev -- prisma migrate reset --force",
    "predb:dev:seed": "npm run db:guard",
    "db:dev:seed": "dotenv -e .env.dev -- tsx prisma/seed-demo.ts",
    "predb:dev:studio": "npm run db:guard",
    "db:dev:studio": "dotenv -e .env.dev -- prisma studio",
    "test:db:setup": "dotenv -e .env.test -- prisma migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed-demo.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.78",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.73.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "node-cron": "^4.6.0",
    "plaid": "^24.0.0",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
